<Project>

  <!--
    Central Package Management (CPM). Every NuGet version for every project in
    RocketWiki.sln lives here; the csproj files carry `<PackageReference Include="..." />`
    with no Version attribute at all. NuGet errors (NU1008) if one reappears, so the
    two cannot drift.

    Why: before this file, fifteen projects each spelled their own versions, and the
    same package appeared in up to six of them. The SQLitePCLRaw security pin was
    written out three times with three slightly different explanations, and the
    xunit/Test SDK quartet six times — so a bump meant six edits, and "did they all
    move together?" was a question you had to answer by grepping. Now a version
    appears once and the rationale for it appears next to it.

    Adding a package: add a PackageVersion here, then reference it without a Version
    in the project that needs it. If exactly one project needs a *different* version
    (there are none today), use VersionOverride on that PackageReference rather than
    silently forking the meaning of the entry here.

    Transitive pinning (CentralPackageTransitivePinningEnabled) is deliberately NOT
    enabled. Two security bumps below — SQLitePCLRaw and
    System.Security.Cryptography.Xml — are expressed as *direct* references on
    purpose, because a direct reference is also what makes the tests exercise the
    version being pinned. Turning on transitive pinning would let those become
    version-only entries with nothing loading them, which is how a pin quietly stops
    proving anything.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- .NET / ASP.NET Core / EF Core. Kept together on 10.0.11: mixing patch levels
       inside this family is what produces the NU1605 downgrade errors that stopped
       RocketWiki.Storage.Tests building at 10.0.0. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
  </ItemGroup>

  <!-- Security bumps over transitively-resolved versions. Both are direct references
       in the projects that need them (see the transitive-pinning note above). -->
  <ItemGroup>
    <!-- EFCore.Sqlite pulls in SQLitePCLRaw 2.1.11, which NU1903 flags for a known
         high-severity advisory. Held a major ahead of that transitive version
         deliberately; the SQLite-backed test tiers are what prove the native bundle
         still loads at 3.x. Referenced by RocketWiki.Api.Tests, RocketWiki.Data.Tests
         and RocketWiki.Sync.Tests — one version, one reason, instead of the three
         copies of this paragraph that used to exist. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Microsoft.Data.SqlClient (via EFCore.SqlServer) pulls in a transitive
         System.Security.Cryptography.Xml 9.0.0, which NU1903 flags for several known
         high-severity advisories. Pinned to a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <!-- Aspire. The AppHost's SDK version (Aspire.AppHost.Sdk in its Sdk attribute) is
       NOT a package reference and is not managed here — keep the two in step by hand
       when upgrading. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.5.3" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.5.3" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <!-- No official Aspire hosting integration exists for Keycloak; this is the
         leading community package (NikiforovAll). See AppHost.cs. -->
    <PackageVersion Include="Keycloak.AuthServices.Aspire.Hosting" Version="0.3.0" />
  </ItemGroup>

  <!-- GraphQL (design.md §8). -->
  <ItemGroup>
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.AspNetCore.CommandLine" Version="16.6.2" />
    <PackageVersion Include="HotChocolate.Diagnostics" Version="16.6.2" />
  </ItemGroup>

  <!-- OpenTelemetry (design.md §15). design.md §15's finding about
       CompositeProcessor.OnEnd being unconditional was established on 1.15.3 and
       re-confirmed on 1.18.0. -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

  <!-- AI: embeddings, "ask the wiki", and MCP (design.md §9, §8). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- The official MCP C# SDK's ASP.NET Core host; brings ModelContextProtocol +
         ModelContextProtocol.Core transitively. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <!-- Storage and image processing (design.md §10, §19). -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.4" />
    <!-- 6.1.1 is exactly what Microsoft.EntityFrameworkCore.SqlServer already drags
         into the solution transitively, so the direct reference in RocketWiki.Storage
         adds no second major version. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- Pinned to the newest 3.x deliberately, NOT 4.x: ImageSharp 4's build-time
         license validation hard-fails Release builds — CI's configuration — without a
         provisioned SixLaborsLicenseKey. Upgrading is this one line plus that key,
         once the licence question is settled. dependabot is configured to withhold
         the major (.github/dependabot.yml) so this pin is not re-proposed weekly.
         Licence either way: Six Labors Split License — Apache-2.0 terms for
         open-source / small-organization use, commercial otherwise; needs a
         deliberate operator sign-off for this deployment. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Test infrastructure (design.md §14). On any Test SDK or runner major bump,
       check the per-project test COUNTS are unchanged rather than just that the run
       is green — a runner that silently stops discovering a tier is still "green". -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- MetricCollector<T> and FakeLogger, for asserting instruments actually emit. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <!-- FakeTimeProvider, for the edit-session registry's deterministic sweep tests. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <!-- design.md §14 tier 3: real SQL Server per run. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
  </ItemGroup>

</Project>
