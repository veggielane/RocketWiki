<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <!-- SqlServerFileStorage (design.md §10, the opt-in provider). ADO.NET only: this
         project deliberately references neither EF Core nor RocketWiki.Data, whose blob
         table would otherwise have to join the migration chain every deployment
         applies. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- ValidateDataAnnotations() for FileStorageOptions. The API host gets this
         assembly free from the ASP.NET Core shared framework; this class library
         does not, and AddFileStorage is where the validation belongs (every host
         that registers file storage should get it, not just the API). -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <!-- StorageKey stays internal (it is a provider implementation detail, not part
         of the IFileStorage contract) while its validation rules get direct unit
         coverage. -->
    <InternalsVisibleTo Include="RocketWiki.Storage.Tests" />
  </ItemGroup>

</Project>
