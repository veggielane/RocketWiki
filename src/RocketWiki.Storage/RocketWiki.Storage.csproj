<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.3" />
    <!-- SqlServerFileStorage (design.md §10, the opt-in provider). 6.1.1 is exactly what
         Microsoft.EntityFrameworkCore.SqlServer 10.0.0 already drags into the solution
         transitively, so this adds a direct reference rather than a second major version.
         ADO.NET only: this project deliberately references neither EF Core nor
         RocketWiki.Data, whose blob table would otherwise have to join the migration
         chain every deployment applies. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <!-- ValidateDataAnnotations() for FileStorageOptions. The API host gets this
         assembly free from the ASP.NET Core shared framework; this class library
         does not, and AddFileStorage is where the validation belongs (every host
         that registers file storage should get it, not just the API). -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- StorageKey stays internal (it is a provider implementation detail, not part
         of the IFileStorage contract) while its validation rules get direct unit
         coverage. -->
    <InternalsVisibleTo Include="RocketWiki.Storage.Tests" />
  </ItemGroup>

</Project>
