<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RocketWiki.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- design.md §9.2 (milestone 7): IEmbeddingGenerator<string, Embedding<float>> —
         the provider-agnostic embedding abstraction. Data consumes the interface only
         (EmbeddingIndexer, hybrid SearchService); the OpenAI-compatible client behind
         it is wired in RocketWiki.Api. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Direct override of a vulnerable transitive version; the advisory and the
         reasoning live with the version in Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketWiki.Core\RocketWiki.Core.csproj" />
    <!-- IAttachmentService needs IFileStorage (design.md §10). RocketWiki.Storage has
         no reference back to Core or Data, so this doesn't create a cycle. -->
    <ProjectReference Include="..\RocketWiki.Storage\RocketWiki.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets RocketWiki.Data.Tests sweep SyncOutboxWriter.Classify over every
         IDomainEvent type by reflection (design.md §12): the outbox's default is
         journal-nothing, so an event nobody classified syncs silently rather than
         failing, and only an exhaustiveness test can catch that. -->
    <InternalsVisibleTo Include="RocketWiki.Data.Tests" />
  </ItemGroup>

</Project>
