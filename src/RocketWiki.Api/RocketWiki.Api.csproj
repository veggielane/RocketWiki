<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c1a5f3b7-6e1a-4f9b-9c3e-2a7d0e8b4f21</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.6.1" />
    <!-- Enables "dotnet run schema export" to keep schema.graphql in sync with
         code (design.md §8); CI drift check is a later hardening step. -->
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.6.1" />
    <PackageReference Include="HotChocolate.Diagnostics" Version="16.6.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- design.md §8/§16 milestone 8: the official MCP C# SDK's ASP.NET Core host —
         streamable HTTP at /mcp inside this process, so tools share the exact
         service layer, JIT provisioning, and audit pipeline GraphQL uses. 2.2.0 is
         the current stable release (nuget.org, 2026-08-13); brings
         ModelContextProtocol + ModelContextProtocol.Core transitively. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- design.md §8: SignalR's MessagePack protocol for /hubs/notifications - keeps
         high-frequency presence frames (pointer moves) small, and is the protocol the
         eventual Yjs binary co-editing updates will want anyway. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.11" />
    <!-- design.md §9.2/§16 milestone 7: the OpenAI-compatible embedding client behind
         Microsoft.Extensions.AI's IEmbeddingGenerator abstraction — self-hosted or
         gateway endpoint, pure config (the Aspire "embeddings" connection string +
         the Ai section). 10.9.0 is the current stable on nuget.org (verified
         2026-08-23); brings Microsoft.Extensions.AI.Abstractions (which
         RocketWiki.Data consumes) and the official OpenAI 2.x client transitively. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- Official Aspire client integration: AddSqlServerDbContext wires
         RocketWikiDbContext to the "rocketwiki" connection string injected by
         the AppHost via service discovery, plus health checks, retry, and
         OpenTelemetry for free (design.md §15) — the idiomatic Aspire path
         rather than hand-rolled AddDbContext/UseSqlServer. -->
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.5.2" />
    <!-- Image normalization for both binary-upload features: avatars
         (Avatars/ImageSharpAvatarProcessor — decode-with-limits, center-crop/resize
         to the canonical 512×512, re-encode to PNG) and custom emojis
         (Emojis/EmojiImageProcessor — square/downscale to 32–256, frame-preserving
         for GIF, metadata scrubbed). Pinned to 3.1.12 (newest 3.x stable, verified
         2026-08-23) deliberately, NOT 4.1.1 (current stable): ImageSharp 4's
         build-time license validation hard-fails Release builds — CI's
         configuration — without a provisioned SixLaborsLicenseKey. Upgrading is
         this one line plus that key once the license question is settled. License
         note either way: Six Labors Split License — Apache-2.0 terms for
         open-source / small-organization use, commercial license otherwise; needs
         a deliberate operator sign-off for this deployment. -->

    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketWiki.ServiceDefaults\RocketWiki.ServiceDefaults.csproj" />
    <ProjectReference Include="..\RocketWiki.Core\RocketWiki.Core.csproj" />
    <ProjectReference Include="..\RocketWiki.Data\RocketWiki.Data.csproj" />
    <ProjectReference Include="..\RocketWiki.Storage\RocketWiki.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets RocketWiki.Api.Tests unit-test AuditContextMiddleware.DetermineChannel
         directly, without a live HTTP round trip per path. -->
    <InternalsVisibleTo Include="RocketWiki.Api.Tests" />
  </ItemGroup>

</Project>
