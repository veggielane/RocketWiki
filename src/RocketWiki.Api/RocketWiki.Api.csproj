<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c1a5f3b7-6e1a-4f9b-9c3e-2a7d0e8b4f21</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <!-- Enables "dotnet run schema export" to keep schema.graphql in sync with
         code (design.md §8); CI drift check is a later hardening step. -->
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" />
    <PackageReference Include="HotChocolate.Diagnostics" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- design.md §8/§16 milestone 8: the official MCP C# SDK's ASP.NET Core host —
         streamable HTTP at /mcp inside this process, so tools share the exact
         service layer, JIT provisioning, and audit pipeline GraphQL uses. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- design.md §8: SignalR's MessagePack protocol for /hubs/notifications - the
         binary protocol the Yjs co-editing updates need (byte[] arguments arrive as
         bytes, not base64 strings), and it keeps presence frames small. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
    <!-- design.md §9.2/§16 milestone 7: the OpenAI-compatible embedding client behind
         Microsoft.Extensions.AI's IEmbeddingGenerator abstraction — self-hosted or
         gateway endpoint, pure config (the Aspire "embeddings" connection string +
         the Ai section). Brings Microsoft.Extensions.AI.Abstractions (which
         RocketWiki.Data consumes) and the official OpenAI 2.x client transitively. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <!-- Official Aspire client integration: AddSqlServerDbContext wires
         RocketWikiDbContext to the "rocketwiki" connection string injected by
         the AppHost via service discovery, plus health checks, retry, and
         OpenTelemetry for free (design.md §15) — the idiomatic Aspire path
         rather than hand-rolled AddDbContext/UseSqlServer. -->
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Image normalization for both binary-upload features: avatars
         (Avatars/ImageSharpAvatarProcessor — decode-with-limits, center-crop/resize
         to the canonical 512×512, re-encode to PNG) and custom emojis
         (Emojis/EmojiImageProcessor — square/downscale to 32–256, frame-preserving
         for GIF, metadata scrubbed). The 3.x pin is deliberate and licence-related —
         see Directory.Packages.props before bumping it. -->
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketWiki.ServiceDefaults\RocketWiki.ServiceDefaults.csproj" />
    <ProjectReference Include="..\RocketWiki.Core\RocketWiki.Core.csproj" />
    <ProjectReference Include="..\RocketWiki.Data\RocketWiki.Data.csproj" />
    <ProjectReference Include="..\RocketWiki.Storage\RocketWiki.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets RocketWiki.Api.Tests unit-test AuditContextMiddleware.DetermineChannel
         directly, without a live HTTP round trip per path. -->
    <InternalsVisibleTo Include="RocketWiki.Api.Tests" />
  </ItemGroup>

</Project>
