<Project Sdk="Aspire.AppHost.Sdk/13.5.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>09b86324-eefb-4fe5-9312-9db2119419cc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <!-- No official Microsoft Aspire hosting integration exists for Keycloak or MinIO.
         Keycloak.AuthServices.Aspire.Hosting (NikiforovAll) is the leading community
         package for Keycloak; MinIO is wired via the generic AddContainer API, which
         is what design.md §15 itself uses. See AppHost.cs for the exact deviations
         from the design.md snippet (method names / API shape only, not intent). -->
    <PackageReference Include="Keycloak.AuthServices.Aspire.Hosting" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <!-- No ProjectReference to RocketWiki.Api on purpose: the API runs as the image
       Dockerfile.api builds (AddDockerfile in AppHost.cs), so the AppHost neither
       builds nor references the project. The same goes for the SPA, which is why
       Aspire.Hosting.JavaScript (AddViteApp) is not referenced either. -->

</Project>
