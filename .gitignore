bin/
obj/
artifacts/
TestResults/

# Node dependencies and tool caches, at every level. `web/`, `web/a11y/` and
# `docs-site/` each ignore their own, but nothing covered a node_modules at the
# REPO ROOT — which is how a vitest results cache
# (node_modules/.vite/vitest/*/results.json) came to be tracked and show up as a
# dirty file in every unrelated diff. One rule here covers all of them.
node_modules/
.vite/

.vs/
.idea/
*.user
*.suo
launchSettings.json

# Claude Code harness runtime state (.claude/agents/ etc. stay tracked)
.claude/scheduled_tasks.lock
.claude/worktrees/
scratch/
*.stackdump

# Incidental artifact of `dotnet run schema export` (only schema.graphql is the checked-in contract)
schema-settings.json
