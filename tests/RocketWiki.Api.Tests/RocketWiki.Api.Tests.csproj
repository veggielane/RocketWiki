<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>RocketWiki.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <!-- FakeTimeProvider, for the edit-session registry's deterministic
         empty-session-grace sweep tests (design.md §8 co-editing). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- design.md §14 integration tier: real API over EF Core on SQLite. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- design.md §8: a real HubConnection against NotificationsHub, not a hand-rolled stand-in. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Direct override of the version EFCore.Sqlite resolves; the advisory and the
         reasoning live with the version in Directory.Packages.props. Running this
         tier is what proves the 3.x native bundle still loads. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RocketWiki.Api\RocketWiki.Api.csproj" />
  </ItemGroup>

</Project>
