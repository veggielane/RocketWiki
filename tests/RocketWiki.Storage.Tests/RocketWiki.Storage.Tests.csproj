<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>RocketWiki.Storage.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MetricCollector<T>, for asserting that StorageTelemetry's instruments actually
         emit (design.md §15/§16: instrumentation counts as done when a test proves it
         fires, not when the call is written). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Bumped from 10.0.0 to 10.0.11 because Microsoft.Extensions.Diagnostics.Testing
         above pulls these in transitively at >= 10.0.10, and NU1605 (warning-as-error
         here) refuses the resulting downgrade. 10.0.11 matches the Microsoft.* pins the
         rest of the solution already uses. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RocketWiki.Storage\RocketWiki.Storage.csproj" />
  </ItemGroup>

</Project>
