<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>RocketWiki.Storage.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MetricCollector<T>, for asserting that StorageTelemetry's instruments actually
         emit (design.md §15/§16: instrumentation counts as done when a test proves it
         fires, not when the call is written). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Referenced directly because this is a class-library test project without the
         ASP.NET Core shared framework. They must stay on the solution's 10.0.11 line:
         Microsoft.Extensions.Diagnostics.Testing above pulls them in transitively at
         >= 10.0.10, and NU1605 refuses the downgrade an older pin would create. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RocketWiki.Storage\RocketWiki.Storage.csproj" />
  </ItemGroup>

</Project>
