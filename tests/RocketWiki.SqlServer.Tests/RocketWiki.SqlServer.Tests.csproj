<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>RocketWiki.SqlServer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- design.md §14 tier 3: real SQL Server via Testcontainers. -->
    <PackageReference Include="Testcontainers.MsSql" />
    <!-- MigrateOnStartup happy path: the real API host against the container. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RocketWiki.Data\RocketWiki.Data.csproj" />
    <ProjectReference Include="..\..\src\RocketWiki.Api\RocketWiki.Api.csproj" />
  </ItemGroup>

  <!-- Thin reuse of the sibling tiers' helpers (design.md §14: this tier re-runs
       high-value scenarios on the real provider, it does not fork the test
       vocabulary). Linked, not copied, so a helper change propagates everywhere. -->
  <ItemGroup>
    <Compile Include="..\RocketWiki.Data.Tests\TestData.cs" Link="Shared\TestData.cs" />
    <Compile Include="..\RocketWiki.Data.Tests\FakeEmbeddingGenerator.cs" Link="Shared\FakeEmbeddingGenerator.cs" />
    <Compile Include="..\RocketWiki.Core.Tests\Content\PageLinkCorpus.cs" Link="Shared\PageLinkCorpus.cs" />
    <Compile Include="..\RocketWiki.Api.Tests\Integration\TestAuthHandler.cs" Link="Shared\TestAuthHandler.cs" />
    <Compile Include="..\RocketWiki.Api.Tests\Integration\TestUserHttpClientExtensions.cs" Link="Shared\TestUserHttpClientExtensions.cs" />
    <Compile Include="..\RocketWiki.Api.Tests\Integration\GraphQLHttpClientExtensions.cs" Link="Shared\GraphQLHttpClientExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SqlServerContainerFixture builds this at runtime when no pre-built image is
         supplied; CI pre-builds the same file (see .github/workflows/ci.yml), and so
         does the AppHost (src/RocketWiki.AppHost/AppHost.cs) - the stock SQL Server
         image cannot apply InitialCreate, so `aspire run` needs the same derived image
         this tier does. Linked from the repo-level docker/ folder rather than owned
         here, so those three consumers cannot drift onto different base images. -->
    <None Include="..\..\docker\mssql-fts\Dockerfile" Link="mssql-fts\Dockerfile"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
